<?xml version="1.0" encoding="utf-8"?>
<!--
  发布配置：默认禁止一切明文 HTTP，只对本机回环开口子。

  为什么需要这个口子：just_audio 在某些路径下会起一个本地回环 HTTP 代理
  （例如给请求注入自定义 header）。那个代理是 http://127.0.0.1:<随机端口>，
  Android 9+ 默认禁明文，会直接报 Cleartext HTTP traffic not permitted，
  表现为「点了播放没声音」。

  回环流量不出设备，开这个口子不降低安全性。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
